generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())

  patientId String @unique

  nama     String
  email    String  @unique
  password String?
  avatar   String?

  notelp String?

  dob       DateTime?
  bloodType BloodType?

  googleId String? @unique
  role     Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens      Token[]
  resetTokens PasswordResetToken[]
  biometric   Biometric?
  lipidPanels LipidPanel[]
  recommendations HealthRecommendation[]
  screenings  Screening[]
  healthGoals HealthGoal[]
  dailyTrackings DailyTracking[]
}

model Biometric {
  id     Int @id @default(autoincrement())
  userId Int @unique

  height Float
  weight Float

  bmi         Float
  bmiCategory String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LipidPanel {
  id     Int @id @default(autoincrement())
  userId Int

  date DateTime?

  totalCholesterol Float
  ldl              Float
  hdl              Float
  triglycerides    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations HealthRecommendation[]
}

enum RecommendationTrigger {
  LIPID_PANEL
  MANUAL
}

model HealthRecommendation {
  id           Int  @id @default(autoincrement())
  userId       Int
  lipidPanelId Int?

  dietaryAdvice  String
  activityAdvice String
  triggerSource  RecommendationTrigger @default(LIPID_PANEL)

  generatedAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lipidPanel LipidPanel? @relation(fields: [lipidPanelId], references: [id], onDelete: SetNull)
}

model Screening {
  id Int @id @default(autoincrement())

  userId Int

  imageUrl String

  result ScreeningResult

  confidence Float

  description String
  recommendation String

  probabilities Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthGoal {
  id Int @id @default(autoincrement())
  userId Int

  targetWeeklyCalories Int
  targetExerciseMins Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyTrackings DailyTracking[]
}

enum ScreeningResult {
  NORMAL
  INDIKASI_RINGAN
  INDIKASI_KUAT
}

enum BloodType {
  A
  B
  AB
  O
}

model Token {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String   @unique
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  USER
}

model DailyTracking {
  id Int @id @default(autoincrement())
  userId Int
  healthGoalId Int

  date DateTime @default(now())

  calories Int
  protein Int
  exerciseMins Int
  foodNotes String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  healthGoal HealthGoal @relation(fields: [healthGoalId], references: [id], onDelete: Cascade)
}

enum LdlGroup {
  NORMAL
  HIGH
}

enum FoodStatus {
  OPTIMAL
  NEUTRAL
  LIMIT
}

model Food {
  id        Int      @id @default(autoincrement())
  name      String
  calories  Float
  proteins  Float
  fat       Float
  
  classifications FoodClassification[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoodClassification {
  id        Int      @id @default(autoincrement())
  foodId    Int
  ldlGroup  LdlGroup
  status    FoodStatus
  isRecommended Boolean

  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([foodId, ldlGroup]) 
}

model TestUpload {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  createdAt DateTime @default(now())
}
