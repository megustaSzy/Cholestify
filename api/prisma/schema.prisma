generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())

  patientId String @unique

  nama     String
  email    String  @unique
  password String?

  notelp String?

  dob       DateTime?
  bloodType BloodType?

  googleId String? @unique
  role     Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens      Token[]
  resetTokens PasswordResetToken[]
  biometric   Biometric?
  screenings  Screening[]
}

model Biometric {
  id     Int @id @default(autoincrement())
  userId Int @unique

  height Float
  weight Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Screening {
  id     Int @id @default(autoincrement())
  userId Int

  imageUrl String

  result     ScreeningResult
  confidence Float?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ScreeningResult {
  NORMAL
  INDICATION
  SEVERE
}

enum BloodType {
  A
  B
  AB
  O
}

model Token {
  id           Int      @id @default(autoincrement())
  userId       Int
  refreshToken String   @unique
  expiresAt    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  USER
}
